# Copy to .env for Docker, or backend/.env for a direct backend run.
DATABASE_URL=postgresql+psycopg://rag:rag@postgres:5432/rag_auditor
QDRANT_URL=http://qdrant:6333
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_PROVIDER=local
LLM_MODE=ollama
JWT_SECRET=change-this-in-production-to-a-long-random-secret
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
CORS_ORIGINS=http://localhost:3000

